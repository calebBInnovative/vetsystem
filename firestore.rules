rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function userRef() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userExists() {
      return isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userClinicId() {
      return userRef().data.clinicId;
    }

    function userRole() {
      return userRef().data.role;
    }

    function isMaster() {
      return userExists() && userRole() == 'master';
    }

    // Platform owner — the person who runs the SaaS, not a clinic user.
    // Matched by e-mail because it needs no custom claim and no extra document
    // read: the address is already inside the auth token. The trade-off is that
    // changing the address means redeploying rules; the long-term alternative is
    // a custom claim set by a Cloud Function with the Admin SDK.
    function isPlatformOwner() {
      return isAuth() && request.auth.token.email == 'calebgtnbacon@gmail.com';
    }

    // Uses a single get() call (not exists() + get()) to stay within Firestore's
    // 10 external-read limit per list-query request. Previously, 2 reads per
    // document evaluation caused permission failures when a collection had more
    // than 5 documents on a user's first full sync.
    function belongsToClinic(clinicId) {
      return isAuth() && userRef().data.clinicId == clinicId;
    }

    // ── User documents ────────────────────────────────────────────────────────
    // Each user can read/write their own profile.
    // Master and admin can manage staff users within their own clinic.

    match /users/{uid} {
      // Self: full access to own document
      allow read, write: if isAuth() && request.auth.uid == uid;

      // Master/admin: read any user (listUsers queries the whole collection)
      allow read: if isAuth() && (isMaster() || userRole() == 'admin');

      // Master/admin: create a new user doc only if it belongs to their clinic
      allow create: if isAuth() && (isMaster() || userRole() == 'admin')
                    && request.resource.data.clinicId == userClinicId();

      // Master/admin: update/delete an existing user doc from their clinic
      allow update, delete: if isAuth() && (isMaster() || userRole() == 'admin')
                            && resource.data.clinicId == userClinicId();
    }

    // ── Clinic root document ──────────────────────────────────────────────────
    // Members of the clinic can read. Only master can write.

    match /clinics/{clinicId} {
      allow read:  if belongsToClinic(clinicId) || isPlatformOwner();
      allow write: if isMaster() && userClinicId() == clinicId;

      // License sub-document
      match /license/{doc} {
        allow read:  if belongsToClinic(clinicId);
        allow write: if isMaster() && userClinicId() == clinicId;
      }

      // All app data (patients, consultations, appointments, products, etc.)
      // The platform owner gets read only: enough to run count() aggregations
      // for metering, never enough to alter a customer's records.
      match /{collection}/{docId} {
        allow read:  if belongsToClinic(clinicId) || isPlatformOwner();
        allow write: if belongsToClinic(clinicId);
      }
    }

    // ── Usage metering ────────────────────────────────────────────────────────
    // One snapshot per clinic per day, written by the Uso y costos screen (and
    // later by a scheduled function). Scoped to the clinic that owns it so a
    // clinic can never read another clinic's figures.

    match /admin/usage/{clinicId}/{day} {
      allow read, write: if isPlatformOwner()
                         || (belongsToClinic(clinicId) && (isMaster() || userRole() == 'admin'));
    }

    // ── Public supplier catalog ───────────────────────────────────────────────
    // Any authenticated user can read (used in /import → Catálogo tab).
    // Only master role can add / edit / delete entries.

    match /publicCatalog/{docId} {
      allow read:  if isAuth();
      allow write: if isMaster();
    }
  }
}
