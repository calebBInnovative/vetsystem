rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function userRef() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userExists() {
      return isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userClinicId() {
      return userRef().data.clinicId;
    }

    function userRole() {
      return userRef().data.role;
    }

    function isMaster() {
      return userExists() && userRole() == 'master';
    }

    // Platform owner — the person who runs the SaaS, not a clinic user.
    // Matched by e-mail because it needs no custom claim and no extra document
    // read: the address is already inside the auth token. The trade-off is that
    // changing the address means redeploying rules; the long-term alternative is
    // a custom claim set by a Cloud Function with the Admin SDK.
    function isPlatformOwner() {
      return isAuth() && request.auth.token.email == 'calebgtnbacon@gmail.com';
    }

    // Uses a single get() call (not exists() + get()) to stay within Firestore's
    // 10 external-read limit per list-query request. Previously, 2 reads per
    // document evaluation caused permission failures when a collection had more
    // than 5 documents on a user's first full sync.
    function belongsToClinic(clinicId) {
      return isAuth() && userRef().data.clinicId == clinicId;
    }

    // ── User documents ────────────────────────────────────────────────────────
    // Profiles are created by the registerClinic Cloud Function (clinic owner) or
    // by a clinic manager (staff). Nobody can change their own role, clinic or
    // permissions: those fields decide which clinic's data a user can reach.

    // Expenses and payroll: only managers and staff granted the Finanzas module.
    // A staff profile without explicit permissions gets the app defaults, which
    // leave finances out (DEFAULT_STAFF_PERMISSIONS in auth.service.ts).
    function financeCollection(collection) {
      return collection in ['fixedExpenses', 'expensePayments', 'collaborators', 'collaboratorPayments'];
    }

    function canUseFinances() {
      return userRef().data.role in ['master', 'admin', 'branch_manager']
          || (userRef().data.permissions != null && userRef().data.permissions.get('finances', false) == true);
    }

    // Branches: inventory, sales, cash, invoices, agenda, quotes, expenses and payroll
    // belong to one branch. Staff and branch managers reach only the branches assigned
    // to them (users/{uid}.branchIds; none = the main branch); clinic managers reach all.
    // Consultations are not listed: the clinical history is shared by every branch.
    // Documents without branchId (from before branches) are the main branch's.
    function branchIsolated(collection) {
      return collection in ['products', 'movements', 'sales', 'payments', 'invoices', 'appointments',
                            'quotes', 'fixedExpenses', 'expensePayments', 'collaborators', 'collaboratorPayments'];
    }

    // A user profile's branches; none = the main branch.
    function branchesOf(data) {
      return data.get('branchIds', []).size() > 0 ? data.branchIds : ['main'];
    }

    function userBranches() {
      return branchesOf(userRef().data);
    }

    function inUserBranch(data) {
      return userRef().data.role in ['master', 'admin'] || data.get('branchId', 'main') in userBranches();
    }

    function staffRole(role) {
      return role in ['admin', 'branch_manager', 'veterinarian', 'reception'];
    }

    // A branch manager runs the staff (not other managers) of their own branches:
    // every branch of the profile, before and after the change, must be theirs.
    function branchManagerReaches(data) {
      return data.role in ['veterinarian', 'reception'] && branchesOf(data).hasOnly(userBranches());
    }

    match /users/{uid} {
      // Self: read own profile and edit it, except identity and access fields
      allow read: if isAuth() && request.auth.uid == uid;
      allow update: if isAuth() && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['uid', 'email', 'role', 'clinicId', 'permissions', 'branchIds']);

      // Master/admin: read the users of their own clinic only (listUsers queries
      // by clinicId). Reading every user exposed other clinics' names and e-mails.
      // Branch managers read them too, to list their branches' team.
      allow read: if isAuth() && (isMaster() || userRole() in ['admin', 'branch_manager'])
                  && resource.data.clinicId == userClinicId();

      // Master/admin: create a staff user doc only in their own clinic
      allow create: if isAuth() && (isMaster() || userRole() == 'admin')
                    && request.resource.data.clinicId == userClinicId()
                    && staffRole(request.resource.data.role);

      // Master/admin: manage staff of their own clinic. The clinic cannot change,
      // and only a master can touch a master account or grant that role.
      allow update: if isAuth() && (isMaster() || userRole() == 'admin')
                    && resource.data.clinicId == userClinicId()
                    && request.resource.data.clinicId == resource.data.clinicId
                    && (isMaster() || (resource.data.role != 'master' && staffRole(request.resource.data.role)));
      allow delete: if isAuth() && (isMaster() || userRole() == 'admin')
                    && resource.data.clinicId == userClinicId()
                    && (isMaster() || resource.data.role != 'master');

      // Branch manager: staff of their own branches only, kept inside those branches.
      allow create: if isAuth() && userRole() == 'branch_manager'
                    && request.resource.data.clinicId == userClinicId()
                    && branchManagerReaches(request.resource.data);
      allow update: if isAuth() && userRole() == 'branch_manager'
                    && resource.data.clinicId == userClinicId()
                    && request.resource.data.clinicId == resource.data.clinicId
                    && branchManagerReaches(resource.data)
                    && branchManagerReaches(request.resource.data);
      allow delete: if isAuth() && userRole() == 'branch_manager'
                    && resource.data.clinicId == userClinicId()
                    && branchManagerReaches(resource.data);
    }

    // ── Clinic root document ──────────────────────────────────────────────────
    // Members of the clinic can read. Only master can write.

    match /clinics/{clinicId} {
      allow read:  if belongsToClinic(clinicId) || isPlatformOwner();
      allow write: if isMaster() && userClinicId() == clinicId;

      // License sub-document
      // Plan, expiration date and status change only through Cloud Functions (the
      // trial at registration, a confirmed payment) or the platform owner. A clinic
      // manager may only keep the displayed clinic name in step with the profile.
      match /license/{doc} {
        allow read:   if belongsToClinic(clinicId) || isPlatformOwner();
        allow write:  if isPlatformOwner();
        allow update: if belongsToClinic(clinicId) && (isMaster() || userRole() == 'admin')
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['clinicName', 'updatedAt']);
      }

      // All app data (patients, consultations, appointments, products, etc.)
      // The platform owner gets read only: enough to run count() aggregations
      // for metering, never enough to alter a customer's records.
      match /{collection}/{docId} {
        allow read:  if (belongsToClinic(clinicId) && (!financeCollection(collection) || canUseFinances())
                         && (!branchIsolated(collection) || inUserBranch(resource.data)))
                     || isPlatformOwner();

        // The license also matches this wildcard; rules grant access if ANY match
        // allows it, so it must be excluded here or every member could renew it.
        function canWrite() {
          return belongsToClinic(clinicId) && collection != 'license'
              && (!financeCollection(collection) || canUseFinances())
              // Branches (points of sale) are created and edited by clinic managers;
              // a branch manager only edits the name and contact of their own.
              && (collection != 'branches' || userRef().data.role in ['master', 'admin'] || branchManagerEdit());
        }
        function branchManagerEdit() {
          return userRef().data.role == 'branch_manager' && docId in userBranches()
              // The main branch is virtual until first saved, so its first save is a create.
              && (resource == null ? docId == 'main'
                  : request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['name', 'address', 'phone', 'updatedAt', 'syncStatus', '_syncedAt']));
        }
        // Staff write only inside their branches, and cannot move a document out of one.
        allow create: if canWrite() && (!branchIsolated(collection) || inUserBranch(request.resource.data));
        allow update: if canWrite() && (!branchIsolated(collection)
                         || (inUserBranch(resource.data) && inUserBranch(request.resource.data)));
        allow delete: if canWrite() && (!branchIsolated(collection) || inUserBranch(resource.data));
      }
    }

    // ── Usage metering ────────────────────────────────────────────────────────
    // One snapshot per clinic per day, written by the Uso y costos screen (and
    // later by a scheduled function). Scoped to the clinic that owns it so a
    // clinic can never read another clinic's figures.

    match /admin/usage/{clinicId}/{day} {
      allow read, write: if isPlatformOwner()
                         || (belongsToClinic(clinicId) && (isMaster() || userRole() == 'admin'));
    }

    // ── Subscription billing (manual payments) ─────────────────────────────────
    // Payment instructions are readable by any signed-in user (clinics need the
    // account numbers to pay) and editable only by the platform owner. Invoices
    // and counters are written only by Cloud Functions (reportManualPayment /
    // reviewManualPayment); a clinic can read its own invoices.

    match /platform/billing {
      allow read:  if isAuth();
      allow write: if isPlatformOwner();
    }

    // Public sales contact for the landing page: a copy of the owner's WhatsApp
    // from platform/billing, which visitors cannot read. Only the platform owner
    // writes it (saveBillingConfig mirrors it on every save).
    match /platform/contact {
      allow read:  if true;
      allow write: if isPlatformOwner();
    }

    // Landing page content (testimonials) edited at /admin/landing. Public: it
    // holds only what the landing shows every visitor.
    match /platform/landing {
      allow read:  if true;
      allow write: if isPlatformOwner();
    }

    // Plan catalog (prices and limits, docs/pricing/pricing-strategy.md). Public:
    // the landing page shows it to visitors, and it holds nothing that is not
    // already advertised. Only the platform owner edits it.
    match /platform/plans {
      allow read:  if true;
      allow write: if isPlatformOwner();
    }

    match /subscriptionInvoices/{invoiceId} {
      allow read:  if isPlatformOwner()
                   || (isAuth() && resource.data.clinicId == userClinicId());
      allow write: if false;
    }

    // Web push tokens of the platform owner's devices
    match /platformPushTokens/{token} {
      allow read, write: if isPlatformOwner();
    }

    // Web push tokens of clinic users' devices (expiry reminders). A user registers
    // only their own device for their own clinic; the server reads them to send.
    match /clinicPushTokens/{token} {
      allow create, update: if isAuth()
                            && request.resource.data.uid == request.auth.uid
                            && request.resource.data.clinicId == userClinicId();
      allow read, delete:   if isAuth()
                            && (resource.data.uid == request.auth.uid || isPlatformOwner());
    }

    // ── Public supplier catalog ───────────────────────────────────────────────
    // Any authenticated user can read (used in /import → Catálogo tab).
    // Only master role can add / edit / delete entries.

    match /publicCatalog/{docId} {
      allow read:  if isAuth();
      allow write: if isMaster();
    }
  }
}
