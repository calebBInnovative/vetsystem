{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/patients/*/history/new/**",
        "destination": "/patients/_/history/new/index.html"
      },
      {
        "source": "/patients/*/history/**",
        "destination": "/patients/_/history/index.html"
      },
      {
        "source": "/consultations/**",
        "destination": "/consultations/_/index.html"
      },
      {
        "source": "/inventory/**",
        "destination": "/inventory/_/index.html"
      },
      {
        "source": "/invoices/**",
        "destination": "/invoices/_/index.html"
      },
      {
        "source": "/patients/**",
        "destination": "/patients/_/index.html"
      },
      {
        "source": "/promotions/**",
        "destination": "/promotions/_/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  },
  "remoteconfig": {
    "template": "remoteconfig.template.json"
  }
}
