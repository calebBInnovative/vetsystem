{
  "name": "vetsystem-functions",
  "description": "VetSystem Firebase Cloud Functions",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "rm -rf lib-test && tsc -p tsconfig.test.json && node --test \"lib-test/test/*.test.js\"",
    "recurrente:check-credentials": "node scripts/check-recurrente-credentials.mjs",
    "test:emulator": "rm -rf lib-test && tsc -p tsconfig.test.json && firebase emulators:exec --only firestore --project demo-vetsystem \"node --test lib-test/test/emulator/*.itest.js\""
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.6.0",
    "svix": "^1.64.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "@types/node": "^22.0.0"
  },
  "private": true
}
